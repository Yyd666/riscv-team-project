{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riscv-optilab:experiment:0.1.0",
  "title": "OptiLab completed experiment response v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "is_mock", "created_at",
    "baseline_version", "baseline_config_sha256", "corpus_version",
    "benchmark_id", "source_sha256", "inputs", "environment", "variants", "selection"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "is_mock": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "baseline_version": {"type": "string", "minLength": 1},
    "baseline_config_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_version": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "stdin_sha256", "expected_stdout_sha256"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "stdin_sha256": {"$ref": "#/$defs/sha256"},
          "expected_stdout_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "python_version", "compiler_version", "binutils_version", "qemu_version", "qemu_cpu", "libc_version", "locale"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "compiler_version": {"type": "string", "minLength": 1},
        "binutils_version": {"type": "string", "minLength": 1},
        "qemu_version": {"type": "string", "minLength": 1},
        "qemu_cpu": {"const": "rv64"},
        "libc_version": {"type": "string", "minLength": 1},
        "locale": {"const": "C"}
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/variant"}
    },
    "selection": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["objective", "optimization", "evidence"],
          "properties": {
            "objective": {"const": "min_text_section_bytes"},
            "optimization": {"enum": ["O0", "O2", "Os"]},
            "evidence": {"const": "static_size_only"}
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elf_file_bytes", "text_section_bytes", "kernel_code_bytes", "kernel_static_instruction_count", "kernel_compressed_instruction_count", "dynamic_instruction_count", "target_cycles"],
      "properties": {
        "elf_file_bytes": {"type": "integer", "minimum": 1},
        "text_section_bytes": {"type": "integer", "minimum": 1},
        "kernel_code_bytes": {"type": "integer", "minimum": 1},
        "kernel_static_instruction_count": {"type": "integer", "minimum": 1},
        "kernel_compressed_instruction_count": {"type": "integer", "minimum": 0},
        "dynamic_instruction_count": {"type": "null"},
        "target_cycles": {"type": "null"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "exit_code", "stdout", "stderr", "wall_time_ms"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "runtime_error", "wrong_answer", "timeout", "output_limit"]},
        "exit_code": {"type": ["integer", "null"]},
        "stdout": {"type": "string", "maxLength": 1048576},
        "stderr": {"type": "string", "maxLength": 1048576},
        "wall_time_ms": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
          "then": {"properties": {"exit_code": {"const": 0}, "stderr": {"const": ""}}}
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optimization", "status", "compile_argv", "run_argv", "analysis_argv", "diagnostics", "kernel_disassembly", "metrics", "runs"],
      "properties": {
        "optimization": {"enum": ["O0", "O2", "Os"]},
        "status": {"enum": ["passed", "compile_error", "runtime_error", "wrong_answer", "timeout", "output_limit", "analysis_error"]},
        "compile_argv": {"$ref": "#/$defs/argv"},
        "run_argv": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/argv"}
          ]
        },
        "analysis_argv": {"type": "array", "items": {"$ref": "#/$defs/argv"}},
        "diagnostics": {"type": "string", "maxLength": 1048576},
        "kernel_disassembly": {"type": ["string", "null"], "maxLength": 1048576},
        "metrics": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/metrics"}
          ]
        },
        "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "metrics": {"$ref": "#/$defs/metrics"},
              "run_argv": {"$ref": "#/$defs/argv"},
              "kernel_disassembly": {"type": "string", "minLength": 1},
              "analysis_argv": {"minItems": 1},
              "runs": {"minItems": 1, "items": {"properties": {"status": {"const": "passed"}}}}
            }
          },
          "else": {"properties": {"metrics": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "compile_error"}}, "required": ["status"]},
          "then": {
            "properties": {
              "run_argv": {"type": "null"},
              "runs": {"maxItems": 0},
              "analysis_argv": {"maxItems": 0},
              "kernel_disassembly": {"type": "null"},
              "diagnostics": {"minLength": 1}
            }
          }
        }
      ]
    }
  }
}
